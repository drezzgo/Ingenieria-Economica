---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Equis UD - Plataforma de Cálculo Financiero | Universidad Distrital",
  description = "Plataforma de cálculo y conversión financiera para la materia de Ingeniería Económica en la Universidad Distrital Francisco José de Caldas."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-neutral-50/20">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Universidad Distrital - Ingeniería Económica" />
    <meta name="robots" content="index, follow" />
    
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen text-neutral-800 bg-white relative overflow-x-hidden antialiased">
    
    <!-- Apple Glow Background Blobs (UDFJC Colors: Red and Yellow/Gold) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      {/* Top Left Red Blob */}
      <div class="absolute top-[-10%] left-[-10%] w-[45%] h-[45%] rounded-full bg-red-600/5 blur-[120px] md:blur-[150px]"></div>
      {/* Bottom Right Yellow/Gold Blob */}
      <div class="absolute bottom-[10%] right-[-5%] w-[40%] h-[40%] rounded-full bg-amber-500/5 blur-[120px] md:blur-[150px]"></div>
    </div>

    <!-- Decorative Top Accent Bar -->
    <div class="h-0.75 w-full bg-linear-to-r from-red-600 via-amber-500 to-red-700 fixed top-0 left-0 right-0 z-50"></div>

    <!-- Header / Navbar (Apple Glassmorphism) -->
    <header class="border-b border-neutral-100/50 sticky top-0 bg-white/70 backdrop-blur-xl z-40 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          
          <!-- Logo & Brand -->
          <div class="flex items-center space-x-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-linear-to-br from-red-600 to-red-700 text-white font-extrabold text-sm shadow-sm border border-amber-400/50">
              X
            </div>
            <div>
              <div class="flex items-center space-x-1.5">
                <span class="text-lg font-bold tracking-tight text-neutral-900">Equis</span>
                <span class="text-lg font-extrabold tracking-tight text-red-600">UD</span>
              </div>
              <span class="text-xs font-semibold uppercase text-neutral-400 tracking-wider block">Ingeniería Económica</span>
            </div>
          </div>

          <!-- University Info -->
          <div class="flex flex-col text-right">
            <span class="text-xs font-bold text-neutral-950 tracking-wider uppercase">
              Universidad Distrital Francisco José de Caldas
            </span>
            <span class="text-xs text-neutral-500 font-medium mt-0.5">
              Bogotá D.C. · Proyecto Académico
            </span>
          </div>

        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="grow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10">
        <!-- Breadcrumb navigation indicator -->
        <div class="mb-6 flex items-center space-x-2 text-xs text-neutral-400 font-semibold tracking-wider uppercase">
          <span>UDFJC</span>
          <span>/</span>
          <span>Ingeniería Económica</span>
          <span>/</span>
          <span class="text-red-600 font-bold">Equis UD</span>
        </div>
        
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-50/50 border-t border-neutral-100/50 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <div class="flex items-center space-x-3">
            <div class="h-8 w-8 rounded-lg bg-red-600/10 border border-red-500/20 flex items-center justify-center text-xs font-bold text-red-700">
              UD
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-950">Equis UD &copy; 2026</p>
              <p class="text-xs text-neutral-400 font-semibold uppercase tracking-wider">Cálculo Financiero y Análisis de Tasas</p>
            </div>
          </div>
          <div class="text-center sm:text-right text-xs text-neutral-400 font-semibold uppercase tracking-wider">
            <p>Facultad de Ingeniería · Proyecto Académico</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
