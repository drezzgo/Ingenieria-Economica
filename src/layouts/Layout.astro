---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Equi UD - Ingeniería Económica | Universidad Distrital",
  description = "Plataforma de cálculo financiero para la materia de Ingeniería Económica en la Universidad Distrital Francisco José de Caldas."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-neutral-50/50">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Estudiantes UD - Ingeniería Económica" />
    <meta name="robots" content="index, follow" />
    
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen text-neutral-800 bg-white">
    <!-- Top Decorative Banner (UD Colors: Red and Yellow) -->
    <div class="h-2 w-full bg-gradient-to-r from-red-600 via-amber-500 to-red-700"></div>

    <!-- Header / Navbar -->
    <header class="border-b border-neutral-100 sticky top-0 bg-white/90 backdrop-blur-md z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo & Brand -->
          <div class="flex items-center space-x-3">
            <!-- Simulated Crest / Shield Icon using UD Colors -->
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-600 text-white font-extrabold text-lg shadow-md border-2 border-amber-400">
              UD
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <span class="text-xl font-bold tracking-tight text-neutral-900">Equi</span>
                <span class="text-xl font-extrabold tracking-tight text-red-600">UD</span>
              </div>
              <span class="text-xs text-neutral-500 font-medium block -mt-1">Ingeniería Económica</span>
            </div>
          </div>

          <!-- University Name (Desktop) -->
          <div class="hidden md:flex flex-col text-right">
            <span class="text-xs font-semibold text-neutral-900 tracking-wide uppercase">
              Universidad Distrital Francisco José de Caldas
            </span>
            <span class="text-[10px] text-neutral-500 font-medium">
              Facultad de Ingeniería · Bogotá D.C.
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Breadcrumb / Subject indicator -->
        <div class="mb-6 flex flex-wrap gap-2 items-center text-sm text-neutral-500">
          <span>Universidad Distrital</span>
          <span>&middot;</span>
          <span>Facultad de Ingeniería</span>
          <span>&middot;</span>
          <span class="font-medium text-red-600">Ingeniería Económica</span>
        </div>
        
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-50 border-t border-neutral-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="flex items-center space-x-3">
            <div class="h-8 w-8 rounded-full bg-red-600 flex items-center justify-center text-xs font-bold text-white border border-amber-400 shadow-sm">
              UD
            </div>
            <div>
              <p class="text-sm font-semibold text-neutral-900">Equi UD</p>
              <p class="text-xs text-neutral-500">Herramienta de Análisis y Conversión Financiera</p>
            </div>
          </div>
          <div class="text-center md:text-right text-xs text-neutral-500">
            <p>Universidad Distrital Francisco José de Caldas &copy; 2026</p>
            <p class="mt-1">Proyecto Académico · Ingeniería de Sistemas / Ingeniería Económica</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
